# See http://help.github.com/ignore-files/ for more about ignoring files.

# compiled output
/dist
/tmp
/out-tsc

# dependencies
/node_modules

# profiling files
chrome-profiler-events.json
speed-measure-plugin.json

# IDEs and editors
# User-specific stuff
.idea

.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.iml

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# misc
/.sass-cache
/connect.lock
/coverage
/.tmp
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings
debug.log

# mutation testing (Stryker)
# .stryker-tmp holds the sandboxes each mutant run in; reports/ holds the HTML
# mutation report. Both are regenerated per run and must never be committed.
# NOTE: /dist is ignored above, which is why stryker.conf.json needs
# "ignorePatterns": ["!dist/**"] — the command runner tests the compiled
# spec-node output, so Stryker has to be told to copy it into the sandbox.
/.stryker-tmp
/reports

# incremental build artifacts (tsc -b); regenerated, never reviewed
tsconfig.tsbuildinfo
/.tsbuildinfo

# Packed tarballs (`npm pack`) are reproducible output, not source. Committing
# one is a trap: it silently goes stale against HEAD, and then it is being cited
# as evidence of a build that no longer matches the tree. That is exactly what
# happened with the 1.0.0 candidate — the committed .tgz still carried
# `## [1.0.0] - Unreleased` while HEAD had the dated entry. Keep the *report*
# (commands + output) if you want the verification on record, not the bytes.
*.tgz
*.tar.gz

# System Files
.DS_Store
Thumbs.db

# Env file
.env
