# Supply-chain hardening for this package.
#
# min-release-age: refuse to install any package version published less than 7
# days ago. The window that matters is the one between an attacker publishing a
# poisoned version and the ecosystem noticing — npm's own registry malware
# takedowns cluster inside a few days of publication. Seven days trades a little
# freshness for sitting outside that window.
#
# Applies at resolve time, so a brand-new `npm install <pkg>` of a just-published
# version is blocked, and `npm update` will land on the newest version that is old
# enough. Already-pinned lockfile versions are not retroactively rejected.
min-release-age=7

# ignore-scripts: never run dependency lifecycle scripts (preinstall / install /
# postinstall). Arbitrary code execution on `npm install` is the single largest
# npm attack surface, and this package needs none of it: the library itself has no
# lifecycle scripts, and the build is plain tsc + webpack + karma on pure-JS
# dependencies. Verified by a clean `npm ci` rather than assumed.
#
# If a future dependency genuinely requires an install script, unblock that one
# package by name instead of turning this off globally.
ignore-scripts=true
