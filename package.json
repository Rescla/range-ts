{
  "name": "range-ts",
  "version": "1.0.0",
  "description": "RangeMap implementation based on Guava",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "es2015": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "_files_comment": "Ship only what a consumer imports. Without this npm published the whole repo minus .gitignore: 469 files / 14.2 MB including every tsconfig, stryker.conf.json and tsconfig.tsbuildinfo. dist/karma and dist/spec-node are test artifacts and stay out of the tarball.",
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types",
    "!**/*.tsbuildinfo",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Rescla/range-ts.git"
  },
  "keywords": [
    "RangeTS",
    "Guava",
    "RangeMap",
    "Range"
  ],
  "scripts": {
    "build:clean": "shx rm -rf ./dist",
    "compile": "tsc -b ./src/tsconfig.cjs.json ./src/tsconfig.esm.json ./src/tsconfig.types.json ./src/tsconfig.karma.json ./src/tsconfig.karmaconf.json && node ./scripts/finalize-dist.mjs",
    "compile:spec-node": "tsc -b ./src/tsconfig.spec-node.json",
    "compile:karma": "tsc -b ./src/tsconfig.karma.json ./src/tsconfig.karmaconf.json",
    "build": "npm-run-all build:clean compile test",
    "check:dependabot": "node ./scripts/check-dependabot.mjs",
    "test:node": "npm run compile:spec-node && jasmine --config=jasmine.node.json",
    "test:jsdom": "npm run compile:spec-node && jasmine --config=jasmine.jsdom.json",
    "test:chrome": "npm run compile:karma && node -e \"const fs=require('fs'); const specs=fs.globSync('dist/karma/**/*.spec.js'); if(!fs.existsSync('dist/karma/test.js')||specs.length===0) throw new Error('zero compiled specs under dist/karma — refusing to report a passing Chrome run over no tests'); console.log('compiled specs for karma:', specs.length)\" && karma start dist/karma-conf/karma.conf.js --single-run --no-auto-watch --browsers ChromeHeadless --reporters kjhtml,junit,coverage-istanbul",
    "test:mutation": "npm run compile:spec-node && stryker run",
    "test": "npm-run-all check:dependabot test:node test:jsdom test:chrome",
    "test-dev": "npm run compile:karma && karma start dist/karma-conf/karma.conf.js"
  },
  "author": "Marc Fokkert <marcfokkert@xz1.nl>",
  "license": "MIT",
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/jasmine": "^7.0.0",
    "@types/karma": "^6.3.9",
    "@types/lodash": "^4.17.27",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^26.6.6",
    "babel-loader": "^10.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "jasmine": "^7.0.0",
    "js-yaml": "^3.14.0",
    "jsdom": "^30.1.3",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage-istanbul-reporter": "^3.0.3",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "karma-junit-reporter": "^2.0.1",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "5.0.1",
    "lint-staged": "^17.6.0",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "shx": "^0.4.0",
    "typescript": "^7.0.2",
    "webpack": "^5.112.2"
  }
}
